# models/student.py
class Student:
    """Lớp đại diện cho một sinh viên."""
    
    def __init__(self, student_id: str, name: str, day: int, month: int, year: int, major: str):
        self.__student_id = student_id
        self.__name = name
        self.__day = day
        self.__month = month
        self.__year = year
        self.__major = major
        self.__scores = {}       # {subject: score}
        self.__gpa = 0.0

    # === Properties ===
    @property
    def student_id(self) -> str:
        return self.__student_id

    @property
    def name(self) -> str:
        return self.__name

    @name.setter
    def name(self, value: str):
        self.__name = value

    @property
    def birth_year(self) -> int:
        return self.__year

    @birth_year.setter
    def birth_year(self, value: int):
        self.__year = value

    @property
    def major(self) -> str:
        return self.__major

    @major.setter
    def major(self, value: str):
        self.__major = value

    @property
    def scores(self) -> dict:
        return self.__scores

    @property
    def gpa(self) -> float:
        return self.__gpa

    # === Methods ===
    def add_score(self, subject: str, score: float):
        """Thêm hoặc cập nhật điểm một môn học."""
        self.__scores[subject] = score
        self.calculate_gpa()

    def update_score(self, subject: str, new_score: float):
        """Cập nhật điểm môn học."""
        if subject in self.__scores:
            self.__scores[subject] = new_score
            self.calculate_gpa()

    def calculate_gpa(self):
        """Tính GPA trung bình các môn."""
        if not self.__scores:
            self.__gpa = 0.0
        else:
            self.__gpa = sum(self.__scores.values()) / len(self.__scores)

    def get_scores(self) -> dict:
        return self.__scores

    def to_file_string(self) -> str:
        """Chuyển thông tin sinh viên thành dạng chuỗi để ghi file."""
        scores_str = ";".join([f"{k}:{v}" for k, v in self.__scores.items()])
        return f"{self.__student_id}|{self.__name}|{self.__day}/{self.__month}/{self.__year}|{self.__major}|{scores_str}|{self.__gpa:.2f}\n"

    @staticmethod
    def from_file_string(line: str):
        """Tạo đối tượng Student từ dòng dữ liệu trong file."""
        parts = line.strip().split('|')
        if len(parts) < 6:
            return None
        student_id, name, dob, major, scores_str, gpa_str = parts[0], parts[1], parts[2], parts[3], parts[4], parts[5]
        try:
            day, month, year = map(int, dob.split('/'))
        except:
            return None
        student = Student(student_id, name, day, month, year, major)
        if scores_str:
            for item in scores_str.split(';'):
                if ':' in item:
                    sub, sc = item.split(':')
                    try:
                        student.add_score(sub, float(sc))
                    except:
                        pass
        else:
            # Nếu không có điểm, gán GPA từ file
            try:
                student._Student__gpa = float(gpa_str)
            except:
                student._Student__gpa = 0.0
        return student

    def __str__(self):
        return f"{self.__student_id} | {self.__name} | {self.__day}/{self.__month}/{self.__year} | {self.__major} | GPA: {self.__gpa:.2f}"
