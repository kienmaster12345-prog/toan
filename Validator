# utils/validator.py
import re

def is_valid_score(score) -> bool:
    try:
        return 0 <= float(score) <= 10
    except (ValueError, TypeError):
        return False

def is_valid_name(name: str) -> bool:
    return bool(re.match(r"^[A-Za-zÀ-ỹ\s]+$", name.strip()))

def is_valid_student_id(student_id: str) -> bool:
    return bool(re.match(r"^[A-Za-z]{2}\d+$", student_id.strip()))

def is_valid_day(day: int) -> bool:
    return 1 <= day <= 31

def is_valid_month(month: int) -> bool:
    return 1 <= month <= 12

def is_valid_year(year: int) -> bool:
    return 1900 <= year <= 2010

def validate_date(day: int, month: int, year: int) -> bool:
    """Kiểm tra ngày hợp lệ (sơ bộ)."""
    return (is_valid_day(day) and is_valid_month(month) and is_valid_year(year))
