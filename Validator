class Validator:
    """Các hàm kiểm tra dữ liệu."""

    @staticmethod
    def is_valid_score(score):
        """Điểm hợp lệ trong khoảng 0-10."""
        try:
            return 0 <= float(score) <= 10
        except (ValueError, TypeError):
            return False

    @staticmethod
    def is_valid_name(name):
        """Tên chỉ gồm chữ cái, khoảng trắng và dấu tiếng Việt."""
        import re
        return bool(re.match(r"^[A-Za-zÀ-ỹ\s]+$", name.strip()))

    @staticmethod
    def is_valid_id(student_id):
        """MSSV dạng chữ + số, ít nhất 2 chữ cái đầu."""
        import re
        return bool(re.match(r"^[A-Za-z]{2}\d+$", student_id.strip()))

    @staticmethod
    def is_valid_date(day, month, year):
        """Kiểm tra ngày tháng năm sơ bộ."""
        if not (1 <= day <= 31 and 1 <= month <= 12 and 1990 <= year <= 2010):
            return False
        # Kiểm tra tháng 2 và ngày 31
        if month == 2 and day > 29:
            return False
        if month in [4, 6, 9, 11] and day > 30:
            return False
        return True
