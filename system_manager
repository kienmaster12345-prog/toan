from student import Student
from file_handler import FileHandler

class SystemManager:
    """Quản lý danh sách sinh viên, các thao tác CRUD, tìm kiếm, sắp xếp, GPA."""

    def __init__(self):
        self.students = []
        self.load_from_file()

    # ------------------ LOAD / SAVE FILE ------------------
    def load_from_file(self):
        """Đọc danh sách sinh viên từ file students.txt."""
        fh = FileHandler("students.txt")
        lines = fh.read_lines()
        self.students = []
        for line in lines:
            s = Student.from_file_string(line)
            if s:
                self.students.append(s)
        print(f"Đã tải {len(self.students)} sinh viên từ file.")

    def save_to_file(self):
        """Ghi toàn bộ danh sách sinh viên vào file (ghi đè)."""
        fh = FileHandler("students.txt")
        lines = [s.to_file_string() for s in self.students]
        fh.rewrite_lines(lines)
        print("Đã lưu toàn bộ danh sách sinh viên.")

    # ------------------ THÊM ------------------
    def add_student(self, student=None):
        """Thêm một sinh viên. Nếu student=None thì nhập mới."""
        if student is None:
            student = Student.input_new_student()
        self.students.append(student)
        self.save_to_file()
        print("Thêm sinh viên thành công!")

    # ------------------ HIỂN THỊ ------------------
    def show_students(self):
        if not self.students:
            print("Danh sách sinh viên trống.")
            return
        print("\n===== DANH SÁCH SINH VIÊN =====")
        for idx, s in enumerate(self.students, 1):
            print(f"{idx}. {s}")
            if s.get_scores():
                print("   Điểm: ", end="")
                for sub, sc in s.get_scores().items():
                    print(f"{sub}:{sc} ", end="")
                print()
        print("================================")

    # ------------------ TÌM KIẾM ------------------
    def find_by_id(self, student_id):
        for s in self.students:
            if s.get_id() == student_id:
                return s
        return None

    def search_by_name(self, keyword):
        """Trả về danh sách sinh viên có tên chứa keyword (không phân biệt hoa/thường)."""
        kw = keyword.strip().lower()
        return [s for s in self.students if kw in s.get_name().lower()]

    def search_by_id(self, student_id):
        """Trả về danh sách (tối đa 1) sinh viên có MSSV trùng khớp chính xác."""
        s = self.find_by_id(student_id)
        return [s] if s else []

    # ------------------ SỬA / XÓA ------------------
    def edit_student(self, student_id):
        """Sửa thông tin cơ bản của sinh viên (trừ MSSV)."""
        s = self.find_by_id(student_id)
        if not s:
            print(f"Không tìm thấy sinh viên có MSSV {student_id}")
            return
        print("Để trống nếu không muốn thay đổi.")
        new_name = input(f"Họ tên cũ: {s.get_name()}\nNhập tên mới: ").strip()
        if new_name:
            s._Student__name = new_name  # truy cập private (có thể thêm setter)
        new_birth = input(f"Ngày sinh cũ: {s.get_birth_str()}\nNhập ngày mới (dd/mm/yyyy): ").strip()
        if new_birth:
            try:
                d, m, y = map(int, new_birth.split("/"))
                if Validator.is_valid_date(d, m, y):
                    s._Student__day, s._Student__month, s._Student__year = d, m, y
                else:
                    print("Ngày không hợp lệ, giữ nguyên cũ.")
            except:
                pass
        new_major = input(f"Ngành cũ: {s.get_major()}\nNhập ngành mới: ").strip()
        if new_major:
            s._Student__major = new_major
        self.save_to_file()
        print("Cập nhật thông tin thành công!")

    def delete_student(self, identifier):
        """Xóa sinh viên theo MSSV hoặc tên (nếu tên có thể trùng sẽ xóa tất cả)."""
        # Thử tìm theo MSSV trước
        s = self.find_by_id(identifier)
        if s:
            self.students.remove(s)
            self.save_to_file()
            print(f"Đã xóa sinh viên {s.get_name()} (MSSV: {identifier})")
            return
        # Nếu không, tìm theo tên
        matches = self.search_by_name(identifier)
        if not matches:
            print("Không tìm thấy sinh viên nào.")
            return
        if len(matches) > 1:
            print(f"Có {len(matches)} sinh viên trùng tên '{identifier}':")
            for idx, m in enumerate(matches, 1):
                print(f"{idx}. {m.get_id()} - {m.get_name()}")
            confirm = input("Bạn muốn xóa tất cả? (y/n): ").lower()
            if confirm != 'y':
                print("Hủy xóa.")
                return
            for m in matches:
                self.students.remove(m)
        else:
            self.students.remove(matches[0])
        self.save_to_file()
        print("Xóa thành công!")

    # ------------------ NHẬP ĐIỂM CHO SINH VIÊN ------------------
    def add_scores_for_student(self, student_id):
        s = self.find_by_id(student_id)
        if not s:
            print(f"Không có sinh viên {student_id}")
            return
        s.add_score()
        self.save_to_file()

    # ------------------ SẮP XẾP ------------------
    def sort_students_by_name(self):
        self.students.sort(key=lambda s: s.get_name().lower())
        print("Đã sắp xếp theo tên (A-Z).")
        self.show_students()

    def sort_students_by_gpa(self, reverse=True):
        self.students.sort(key=lambda s: s.get_gpa(), reverse=reverse)
        print("Đã sắp xếp theo GPA (cao xuống thấp).")
        self.show_students()

    def sort_students_by_id(self):
        self.students.sort(key=lambda s: s.get_id())
        print("Đã sắp xếp theo MSSV.")
        self.show_students()

    # ------------------ GPA TỔNG ------------------
    def overall_gpa(self):
        if not self.students:
            print("Chưa có sinh viên nào.")
            return
        total = sum(s.get_gpa() for s in self.students)
        avg = total / len(self.students)
        print(f"GPA trung bình toàn khóa: {avg:.2f}")
        return avg

