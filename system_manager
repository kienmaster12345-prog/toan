import ast

from models.student import Student
from utils.file_handler import FileHandler


class SystemManager:

    def __init__(self):

        self.students = []

        self.file_handler = FileHandler(
            "data/students.txt"
        )

    def add_student(self, student):

        self.students.append(student)

    def show_students(self):

        for student in self.students:
            print(student)

    def search_by_name(self, name):

        return [
            s for s in self.students
            if name.lower() in s.name.lower()
        ]

    def search_by_id(self, student_id):

        return [
            s for s in self.students
            if s.student_id == student_id
        ]

    def delete_student(self, student_id):

        self.students = [
            s for s in self.students
            if s.student_id != student_id
        ]

    def sort_by_name(self):

        self.students.sort(
            key=lambda s: s.name.lower()
        )

    def sort_by_gpa(self):

        self.students.sort(
            key=lambda s: s.calculate_gpa(),
            reverse=True
        )

    def sort_by_birth_year(self):

        self.students.sort(
            key=lambda s: s.birth_year
        )

    def get_overall_gpa(self):

        if not self.students:
            return 0

        total = sum(
            s.calculate_gpa()
            for s in self.students
        )

        return round(
            total / len(self.students),
            2
        )

    def save_to_file(self):

        lines = [
            s.to_file_string()
            for s in self.students
        ]

        self.file_handler.write_lines(lines)

    def load_from_file(self):

        self.students.clear()

        for line in self.file_handler.read_lines():

            data = line.strip().split("|")

            student = Student(
                data[0],
                data[1],
                int(data[2]),
                int(data[3]),
                int(data[4]),
                data[5],
                ast.literal_eval(data[6])
            )

            self.students.append(student)
