# services/system_manager.py
from models.student import Student
from utils.file_handler import FileHandler
from utils.validator import is_valid_name, is_valid_student_id, validate_date
from services.score_manager import ScoreManager

class SystemManager:
    def __init__(self, file_path: str = "students.txt"):
        self.file_handler = FileHandler(file_path)
        self.students = []
        self.score_manager = ScoreManager()
        self.load_from_file()   # tự động load dữ liệu khi khởi tạo

    # ========== FILE I/O ==========
    def save_to_file(self):
        """Lưu toàn bộ danh sách sinh viên vào file."""
        self.file_handler.save_students(self.students)
        print("Đã lưu dữ liệu thành công!")

    def load_from_file(self):
        """Tải danh sách sinh viên từ file."""
        self.students = self.file_handler.read_students()
        print(f"Đã tải {len(self.students)} sinh viên từ file.")

    # ========== CRUD ==========
    def add_student(self):
        try:
            # Nhập ID
            while True:
                student_id = input("MSSV (vd: SE210910): ").strip()
                if not is_valid_student_id(student_id):
                    print("Sai định dạng! Gồm 2 chữ cái + số.")
                    continue
                if self.find_student_by_id(student_id):
                    print("MSSV đã tồn tại!")
                    continue
                break

            # Nhập tên
            while True:
                name = input("Họ tên: ").strip()
                if is_valid_name(name):
                    break
                print("Tên chỉ chứa chữ cái và khoảng trắng!")

            # Nhập ngày sinh
            while True:
                try:
                    day = int(input("Ngày sinh (1-31): "))
                    month = int(input("Tháng sinh (1-12): "))
                    year = int(input("Năm sinh (1900-2010): "))
                    if validate_date(day, month, year):
                        break
                    print("Ngày tháng năm không hợp lệ!")
                except ValueError:
                    print("Vui lòng nhập số!")

            # Nhập ngành
            while True:
                major = input("Ngành học: ").strip()
                if major:
                    break
                print("Ngành không được để trống!")

            student = Student(student_id, name, day, month, year, major)
            self.students.append(student)
            self.save_to_file()   # tự động lưu sau khi thêm
            print("Thêm sinh viên thành công!")

        except Exception as e:
            print(f"Lỗi khi thêm sinh viên: {e}")

    def show_all_students(self):
        if not self.students:
            print("Danh sách sinh viên trống.")
            return
        print("\n===== DANH SÁCH SINH VIÊN =====")
        for idx, s in enumerate(self.students, 1):
            print(f"{idx}. {s}")

    def find_student_by_id(self, student_id: str):
        for s in self.students:
            if s.student_id == student_id:
                return s
        return None

    def edit_student(self):
        student_id = input("Nhập MSSV cần sửa: ").strip()
        student = self.find_student_by_id(student_id)
        if not student:
            print("Không tìm thấy sinh viên!")
            return
        try:
            new_name = input("Tên mới (bỏ trống nếu không đổi): ").strip()
            if new_name:
                if is_valid_name(new_name):
                    student.name = new_name
                else:
                    print("Tên không hợp lệ, giữ nguyên.")

            new_year = input("Năm sinh mới (bỏ trống nếu không đổi): ").strip()
            if new_year:
                student.birth_year = int(new_year)

            new_major = input("Ngành mới (bỏ trống nếu không đổi): ").strip()
            if new_major:
                student.major = new_major

            self.save_to_file()
            print("Cập nhật thành công!")
        except Exception as e:
            print(f"Lỗi: {e}")

    def delete_student(self):
        student_id = input("Nhập MSSV cần xóa: ").strip()
        student = self.find_student_by_id(student_id)
        if student:
            self.students.remove(student)
            self.save_to_file()
            print("Đã xóa sinh viên.")
        else:
            print("Không tìm thấy!")

    # ========== SEARCH ==========
    def search_by_name(self, keyword: str):
        keyword_lower = keyword.lower()
        return [s for s in self.students if keyword_lower in s.name.lower()]

    def search_by_id(self, student_id: str):
        for s in self.students:
            if s.student_id == student_id:
                return [s]
        return []

    # ========== SORT ==========
    def sort_by_gpa(self, reverse=True):
        self.students.sort(key=lambda s: s.gpa, reverse=reverse)

    def sort_by_name(self):
        self.students.sort(key=lambda s: s.name.lower())

    def sort_by_birth_year(self):
        self.students.sort(key=lambda s: s.birth_year)

    # ========== GPA OVERALL ==========
    def get_overall_gpa(self):
        if not self.students:
            print("Không có sinh viên nào.")
            return 0.0
        total = sum(s.gpa for s in self.students)
        avg = total / len(self.students)
        print(f"Điểm GPA trung bình toàn lớp: {avg:.2f}")
        return avg

    # ========== DELEGATE TO SCORE_MANAGER ==========
    def add_scores_for_student(self):
        student_id = input("Nhập MSSV để nhập điểm: ").strip()
        student = self.find_student_by_id(student_id)
        if student:
            self.score_manager.enter_scores(student)
            self.save_to_file()
        else:
            print("Không tìm thấy sinh viên!")

    def update_score_for_student(self):
        student_id = input("Nhập MSSV để sửa điểm: ").strip()
        student = self.find_student_by_id(student_id)
        if student:
            self.score_manager.update_score(student)
            self.save_to_file()
        else:
            print("Không tìm thấy sinh viên!")

    def view_scores_of_student(self):
        student_id = input("Nhập MSSV để xem điểm: ").strip()
        student = self.find_student_by_id(student_id)
        if student:
            self.score_manager.view_scores(student)
        else:
            print("Không tìm thấy sinh viên!")
